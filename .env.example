# Copy to .env and replace both local-only placeholders.
DB_URL=jdbc:postgresql://127.0.0.1:5432/kali_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kali_db
DB_USER=kali_app
DB_PASSWORD=replace-with-a-local-only-runtime-secret
DB_MIGRATION_USER=kali_migrator
DB_MIGRATION_PASSWORD=replace-with-a-local-only-migration-secret
COOKIE_SECURE=false
HEALTH_CONSENT_VERSION=2026-01
